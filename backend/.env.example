# RazorFlow AI Environment Variables (Template)
# Copy this file to .env and insert your real credentials

GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=sqlite+aiosqlite:///./razorflow.db
SECRET_KEY=your_secret_key_here

# Razorpay Test / Production API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Email Dispatch (Gmail App Password)
GMAIL_SENDER=your_email@domain.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Green-API WhatsApp Dispatch
GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token
